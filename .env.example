NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google Cloud Console -> OAuth client ID (Web application). Authorized
# redirect URI must be {SUPABASE_URL}/auth/v1/callback (GoTrue's own
# callback, not this app's /auth/callback route). Blank is fine locally --
# the Google button degrades to a clear "isn't configured yet" message.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Same value as SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID above, mirrored under
# NEXT_PUBLIC_ so the browser button can tell it's configured -- client IDs
# aren't secret, only the OAuth secret is.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM="Aqd <auth@example.com>"
DEVICE_COOKIE_NAME=aqd_device
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
