NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google Cloud Console -> OAuth client ID (Web application). Authorized
# redirect URI must be {SUPABASE_URL}/auth/v1/callback (GoTrue's own
# callback, not this app's /auth/callback route). Blank is fine locally --
# the Google button degrades to a clear "isn't configured yet" message.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Same value as SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID above, mirrored under
# NEXT_PUBLIC_ so the browser button can tell it's configured -- client IDs
# aren't secret, only the OAuth secret is.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM="Aqd <auth@example.com>"
DEVICE_COOKIE_NAME=aqd_device
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional. Not a fourth tier you select -- an automatic last-resort
# fallback used only when the requested tier's own provider (Gemini/
# Anthropic) fails or has no key configured. Blank is fine; behavior is
# byte-for-byte identical to without this section when unset.
OPENROUTER_API_KEY=
# openai/gpt-oss-20b:free is NOT usable as configured here -- confirmed live
# (404 "unavailable for free") both when this fallback was first built and
# again since. Keep pointed at a slug that's actually live on the free tier;
# check https://openrouter.ai/models?max_price=0 before changing this.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Explicit developer override: forces every AI call through OpenRouter
# regardless of Gemini/Anthropic's health, for testing the OpenRouter path
# on demand without needing a real outage. Only 'openrouter' does anything;
# unset (the normal case) leaves every tier's own provider untouched.
AI_FORCE_PROVIDER=
# Explicit off-switch for the automatic OpenRouter fallback -- set to
# "false" during a QA run that needs to see Gemini/Anthropic's own real
# failures instead of having them silently absorbed by a fallback answer.
# Any other value (including unset) keeps fallback on, which is the
# production-desired default.
AI_FALLBACK_ENABLED=
# Per-attempt timeout (ms) for every AI provider fetch. Without this, a
# fetch() has no timeout at all -- confirmed live: under real Gemini "high
# demand" 503s, one analyzeContract call took 154877ms and another 175375ms
# before failing, because each individual attempt was hanging, not fast-
# failing. Default 15000 if unset.
AI_REQUEST_TIMEOUT_MS=
